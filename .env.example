# Copie para .env e gere valores novos. Nunca versione o arquivo .env.
POSTGRES_DB=academia
POSTGRES_USER=academia
POSTGRES_PASSWORD=substitua-por-uma-senha-longa
# String de conexão que o Flask/SQLAlchemy realmente lê (servidor.py exige - a app não sobe sem isso).
# Local (Postgres via socket Unix): postgresql+psycopg2://usuario@/nome_do_banco?host=/var/run/postgresql
# Remoto/produção: postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/academia
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
ADMIN_USER=admin
ADMIN_PASSWORD=substitua-por-uma-senha-de-administrador-longa
# Chave de API da Brevo (brevo.com), usada para enviar e-mails transacionais.
BREVO_API_KEY=substitua-pela-sua-chave-da-api-brevo
BREVO_SENDER_EMAIL=contato@seudominio.com.br
BREVO_SENDER_NAME=Extreme Team
# E-mail que recebe o aviso de novo cadastro aguardando aprovação.
ADMIN_EMAIL=admin@seudominio.com.br
# Portas publicadas pelo proxy Caddy (HTTPS na frente do app).
HTTPS_PORT=443
HTTP_PORT=80
# true exige HTTPS para os cookies de sessão - só desative para debug sem o Caddy.
COOKIE_SECURE=true
# Mercado Pago (Pix) - credenciais de teste em https://www.mercadopago.com.br/developers
MERCADO_PAGO_ACCESS_TOKEN=substitua-pelo-access-token-do-mercado-pago
MERCADO_PAGO_WEBHOOK_SECRET=substitua-pela-assinatura-secreta-do-webhook
# URL pública (HTTPS) onde este app está publicado - usada para montar o link do webhook.
APP_BASE_URL=https://seudominio.com.br
# Pasta onde ficam fotos de perfil e comprovantes manuais (fora de static/, nunca
# público por URL direta). Local: caminho relativo, ex. "uploads". Via docker
# compose: já vem fixado em /app/uploads (volume nomeado "uploads_data" no
# compose.yaml) - NÃO sobrescreva esse valor no .env usado com o compose, ou os
# arquivos deixam de cair no volume persistente e somem no próximo rebuild.
UPLOAD_DIR=uploads
