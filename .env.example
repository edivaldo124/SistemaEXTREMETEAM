# Copie para .env e gere valores novos. Nunca versione o arquivo .env.
POSTGRES_DB=academia
POSTGRES_USER=academia
POSTGRES_PASSWORD=substitua-por-uma-senha-longa
# String de conexão que o Flask/SQLAlchemy realmente lê (servidor.py exige - a app não sobe sem isso).
# Local (Postgres via socket Unix): postgresql+psycopg2://usuario@/nome_do_banco?host=/var/run/postgresql
# Remoto/produção: postgresql+psycopg2://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/academia
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
ADMIN_USER=admin
# Senha do administrador: somente hash. Gere com `python -m servicos.credenciais`.
# Mantenha o hash entre aspas simples para o Docker Compose não interpretar os $.
# Não use nem crie ADMIN_PASSWORD em texto puro.
ADMIN_PASSWORD_HASH='cole-o-hash-gerado-aqui'
# Gmail OAuth 2.0: o administrador conecta a própria conta pelo sistema.
# O refresh token não fica no .env; será salvo criptografado no banco após a autorização.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# E-mail que recebe o aviso de novo cadastro aguardando aprovação.
ADMIN_EMAIL=admin@seudominio.com.br
# Portas publicadas pelo proxy Caddy (HTTPS na frente do app).
HTTPS_PORT=443
HTTP_PORT=80
# O padrão da aplicação é true. Use false somente no desenvolvimento local sem HTTPS.
# A aplicação recusa false quando APP_BASE_URL usa https.
COOKIE_SECURE=true
# Obrigatório: hosts aceitos separados por vírgula. Use localhost,127.0.0.1 no local
# ou o domínio real em produção. A configuração pública está descrita no README.
TRUSTED_HOSTS=seudominio.com.br
# Quantidade de proxies confiáveis entre o cliente e o Flask. O compose usa um Caddy.
# Precisa bater com a realidade: alto demais faz a aplicação confiar num
# X-Forwarded-For escrito pelo cliente, e o limite por IP passa a ser contornável
# trocando o cabeçalho. Com o compose deste repositório o valor é 1.
TRUST_PROXY_COUNT=1
# Armazenamento dos limites de requisição. PRECISA ser compartilhado em produção:
# com o padrão `memory://` a contagem vive dentro de cada processo, então cada worker
# Gunicorn tem a sua e o limite real vira (limite x nº de workers) - e zera a cada
# reinício. O compose já aponta esta variável para o serviço `rate-limit` (Redis).
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Mercado Pago - o webhook e sempre validado com a assinatura secreta do APLICATIVO
# (painel de desenvolvedor > Webhooks). Ela continua obrigatoria mesmo com OAuth.
MERCADO_PAGO_WEBHOOK_SECRET=substitua-pela-assinatura-secreta-do-webhook
# Conexao por OAuth (recomendado): quem opera a plataforma cria UM aplicativo em
# https://www.mercadopago.com.br/developers e informa aqui o Client ID e o Client Secret.
# A academia so clica em "Conectar Mercado Pago" em /admin/academia - sem criar app nem
# colar token. No aplicativo, cadastre como URL de redirecionamento:
#   ${APP_BASE_URL}/admin/mercado-pago/callback
# e ative o PKCE.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Opcional: chave Fernet que cifra os tokens guardados no banco. Gere com
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sem ela, a chave e derivada da SECRET_KEY (trocar a SECRET_KEY exige reconectar a conta).
MERCADO_PAGO_TOKEN_KEY=
# Alternativa manual (modo antigo): access token fixo. So e usado enquanto NAO houver
# conta conectada por OAuth - a conexao sempre tem prioridade.
MERCADO_PAGO_ACCESS_TOKEN=
# URL pública (HTTPS) onde este app está publicado - usada para montar o link do webhook
# e as URLs de retorno do Checkout Pro (obrigatória para "outras formas de pagamento").
APP_BASE_URL=https://seudominio.com.br
# Opcional: "producao" ou "sandbox". Decide se o Checkout Pro manda o aluno para o
# init_point real ou para o sandbox_init_point. Se ficar vazia, o ambiente é deduzido do
# prefixo do access token ("TEST-" = sandbox). Preencha para não depender da dedução.
MERCADO_PAGO_AMBIENTE=
# Pasta onde ficam fotos de perfil e comprovantes manuais (fora de static/, nunca
# público por URL direta). Local: caminho relativo, ex. "uploads". Via docker
# compose: já vem fixado em /app/uploads (volume nomeado "uploads_data" no
# compose.yaml) - NÃO sobrescreva esse valor no .env usado com o compose, ou os
# arquivos deixam de cair no volume persistente e somem no próximo rebuild.
UPLOAD_DIR=uploads
# Keep-alive: em hospedagem de plano gratuito (Render) o serviço hiberna depois de
# ~15 min sem tráfego. Com "true", a app bate no próprio /health de tempos em tempos
# para reduzir a inatividade, sem garantia contra hibernação ou reinício.
# Exige APP_BASE_URL preenchida. Deixe vazio/false em local e no
# compose (aqui nada hiberna).
KEEP_ALIVE=false
# Segundos entre os pings. Padrão 600; aceita de 60 a 840 (acima disso o Render já dormiu).
KEEP_ALIVE_INTERVALO=600
